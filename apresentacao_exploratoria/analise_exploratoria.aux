\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Resultados publicados: Marques et al., Tabela 2, p.~61; Sanguinet e Azzoni, Tabela 3, p.~7. As contas diferem em ano, unidade e recorte; 1 Mt = 1.000 Gg.}}{2}{table.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Entradas utilizadas. Os números 01, 02, 03, 13 e 15 identificam as abas da MIP de 2015, nível 67.}}{3}{table.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Matriz completa $C=\Phi L$, com as 67 atividades nas linhas e colunas. Unidade: Gg de CO$_2$ por R\$ milhão de demanda final. Escala logarítmica; zeros na cor mais clara.}}{5}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Emissões, razão entre participações nas emissões e no VAB, e participação no VAB: 67 atividades ordenadas da maior para a menor emissão. Todos os indicadores e atividades do notebook são apresentados.}}{7}{figure.3}\protected@file@percent }
