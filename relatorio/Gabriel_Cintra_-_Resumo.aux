\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Matriz P: heatmap. As linhas identificam as atividades emissoras e as colunas, os destinos da demanda final. A diagonal reúne as atribuições à própria atividade. A cor representa a escala logarítmica indicada no gráfico.}}{3}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Emissões próprias e participação no valor adicionado bruto. Os três painéis mostram emissões próprias, razão entre participações nas emissões e no VAB, e participação no VAB. As atividades estão ordenadas pelas emissões próprias.}}{4}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rede agregada em disposição circular. As 20 maiores emissoras são mantidas; as demais formam Outras. A área representa emissões próprias; a espessura, o peso da relação; a cor, a diversidade de destinos, crescente do roxo ao amarelo. As setas indicam os destinos da demanda final.}}{5}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Rede agregada em disposição por forças. São os mesmos nós, pesos e escalas da figura anterior. A posição não representa distância econômica. As relações incluem requisitos diretos e indiretos; caminhos no desenho não são etapas físicas adicionais da produção.}}{6}{figure.4}\protected@file@percent }
